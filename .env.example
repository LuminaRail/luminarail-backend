# LuminaRail Backend — Environment Variable Configuration Template
# DO NOT commit real credentials or secrets to version control.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://luminarail:luminarail@localhost:5432/luminarail?schema=public

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Stellar Network Configuration (Testnet / Future Mainnet)
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_USDC_ISSUER=GBBD47IF6LWK2P7MDEVSCWR7DPCCM3GHESLGZWYF26TYD40010010001
STELLAR_SETTLEMENT_VAULT_CONTRACT_ID=

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_key_placeholder
JWT_EXPIRES_IN=1d

# Local Payment Provider Configuration (Placeholders)
PAYMENT_PROVIDER_ID=default_provider
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
